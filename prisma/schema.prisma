generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}


// 1. Categories
model Category {
  CategoryId   Int     @id @default(autoincrement()) @map("category_id")
  CategoryName String  @map("category_name") @db.VarChar(100)
  Description  String? @map("description") @db.VarChar(255)

  Products Product[]

  @@map("categories")
}

// 2. Suppliers
model Supplier {
  SupplierId   Int     @id @default(autoincrement()) @map("supplier_id")
  SupplierName String  @map("supplier_name") @db.VarChar(150)
  ContactEmail String @map("contact_email") @db.VarChar(150)
  Country      String? @map("country") @db.VarChar(100)

  Products Product[]

  @@map("suppliers")
}

// 3. Products
model Product {
  ProductId   Int      @id @default(autoincrement()) @map("product_id")
  ProductName String   @map("product_name") @db.VarChar(150)
  CategoryId  Int      @map("category_id")
  SupplierId  Int      @map("supplier_id")
  UnitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  CostPrice   Decimal  @map("cost_price") @db.Decimal(10, 2)
  CreatedAt   DateTime @map("created_at") @db.Date

  Category   Category    @relation(fields: [CategoryId], references: [CategoryId])
  Supplier   Supplier    @relation(fields: [SupplierId], references: [SupplierId])
  OrderItems OrderItem[]
  Inventory  Inventory[]

  @@index([CategoryId])
  @@index([SupplierId])
  @@map("products")
}

// 4. Customers
model Customer {
  CustomerId   Int      @id @default(autoincrement()) @map("customer_id")
  FirstName    String   @map("first_name") @db.VarChar(100)
  LastName     String   @map("last_name") @db.VarChar(100)
  Email        String   @unique @map("email") @db.VarChar(150)
  City         String  @map("city") @db.VarChar(100)
  Country      String  @map("country") @db.VarChar(100)
  RegisteredAt DateTime @map("registered_at") @db.Date

  Orders Order[]

  @@map("customers")
}

// 5. Departments
model Department {
  DepartmentId   Int     @id @default(autoincrement()) @map("department_id")
  DepartmentName String  @map("department_name") @db.VarChar(100)
  Location       String? @map("location") @db.VarChar(100)

  Employees Employee[]

  @@map("departments")
}

// 6. Employees
model Employee {
  EmployeeId   Int      @id @default(autoincrement()) @map("employee_id")
  FirstName    String   @map("first_name") @db.VarChar(100)
  LastName     String   @map("last_name") @db.VarChar(100)
  DepartmentId Int      @map("department_id")
  HireDate     DateTime @map("hire_date") @db.Date
  JobTitle     String   @map("job_title") @db.VarChar(100)

  Department Department @relation(fields: [DepartmentId], references: [DepartmentId])
  Orders     Order[]

  @@index([DepartmentId])
  @@map("employees")
}

// 7. Orders
model Order {
  OrderId     Int      @id @default(autoincrement()) @map("order_id")
  CustomerId  Int      @map("customer_id")
  EmployeeId  Int?     @map("employee_id")
  OrderDate   DateTime @map("order_date") @db.Date
  OrderStatus String   @map("order_status") @db.VarChar(30)

  Customer   Customer    @relation(fields: [CustomerId], references: [CustomerId])
  Employee   Employee?   @relation(fields: [EmployeeId], references: [EmployeeId])
  OrderItems OrderItem[]
  Payments   Payment[]

  @@index([CustomerId])
  @@index([EmployeeId])
  @@map("orders")
}

// 8. Order Items
model OrderItem {
  OrderItemId Int     @id @default(autoincrement()) @map("order_item_id")
  OrderId     Int     @map("order_id")
  ProductId   Int     @map("product_id")
  Quantity    Int     @map("quantity")
  UnitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

  Order   Order   @relation(fields: [OrderId], references: [OrderId])
  Product Product @relation(fields: [ProductId], references: [ProductId])

  @@index([OrderId])
  @@index([ProductId])
  @@map("order_items")
}

// 9. Payments
model Payment {
  PaymentId     Int      @id @default(autoincrement()) @map("payment_id")
  OrderId       Int      @map("order_id")
  PaymentDate   DateTime @map("payment_date") @db.Date
  Amount        Decimal  @map("amount") @db.Decimal(10, 2)
  PaymentMethod String   @map("payment_method") @db.VarChar(30)
  PaymentStatus String   @map("payment_status") @db.VarChar(30)

  Order Order @relation(fields: [OrderId], references: [OrderId])

  @@index([OrderId])
  @@map("payments")
}

// 10. Warehouses
model Warehouse {
  WarehouseId   Int    @id @default(autoincrement()) @map("warehouse_id")
  WarehouseName String @map("warehouse_name") @db.VarChar(100)
  City          String @map("city") @db.VarChar(100)
  Country       String @map("country") @db.VarChar(100)

  Inventory Inventory[]

  @@map("warehouses")
}

// 11. Inventory
model Inventory {
  InventoryId     Int      @id @default(autoincrement()) @map("inventory_id")
  ProductId       Int      @map("product_id")
  WarehouseId     Int      @map("warehouse_id")
  QuantityInStock Int      @map("quantity_in_stock")
  ReorderLevel    Int      @map("reorder_level")
  LastUpdated     DateTime @map("last_updated") @db.Date

  Product   Product   @relation(fields: [ProductId], references: [ProductId])
  Warehouse Warehouse @relation(fields: [WarehouseId], references: [WarehouseId])

  // One stock record per product per warehouse (also indexes ProductId)
  @@unique([ProductId, WarehouseId])
  @@index([WarehouseId])
  @@map("inventory")
}
